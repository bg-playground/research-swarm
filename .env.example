# OpenAI (or compatible) API key for the supervisor and specialist agents
OPENAI_API_KEY=sk-...

# Firecrawl API key (get one at https://firecrawl.dev)
# Leave blank or comment out if using a self-hosted Firecrawl instance
FIRECRAWL_API_KEY=fc-...

# Optional: point at a self-hosted Firecrawl instance
# FIRECRAWL_API_URL=http://localhost:3002

# LLM controls
# RESEARCH_SWARM_MODEL=gpt-4o-mini
# RESEARCH_SWARM_TEMPERATURE=0

# Logging (DEBUG, INFO, WARNING, ERROR) — default INFO
# RESEARCH_SWARM_LOG_LEVEL=INFO

# URL scrape cache (disk). Speeds re-runs; default on, 24h TTL.
# RESEARCH_SWARM_CACHE_DIR=.cache/research_swarm
# RESEARCH_SWARM_CACHE_TTL_HOURS=24
# RESEARCH_SWARM_CACHE_DISABLED=1

# Optional LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_...
# LANGCHAIN_PROJECT=research-swarm
